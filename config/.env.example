# Copiare in config/.env e proteggerlo con chmod 0600. Il file reale è
# gitignorato; questo esempio versionato è l'inventario per una nuova macchina.

# Ascolto del servizio systemd.
STRUMENTI_3DP_HOST=0.0.0.0
STRUMENTI_3DP_PORT=8085

# Firma il cookie di sessione. Generane una con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiami

# Dati persistenti dell'applicazione.
DATA_DIR=./data

# Marca il cookie `Secure`. Accendere SOLO quando ogni strada per arrivare
# qui è HTTPS. Un true prematuro scollega tutti e il sintomo è identico a
# una password sbagliata.
SECURE_COOKIES=false

# Menu delle applicazioni sullo stesso host (JSON).
APP_AZIENDALI=[{"nome":"Scanner bandi","porta":8083},{"nome":"Strumenti CNC","porta":8084},{"nome":"Strumenti 3DP","porta":8085,"corrente":true}]
